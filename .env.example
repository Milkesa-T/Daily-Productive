# -----------------------------------------------------------------------------
# Daily-Productive Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# -----------------------------------------------------------------------------

# Application Settings
APP_NAME=Daily-Productive
APP_VERSION=1.0.0
DEBUG=False

# Database (Supabase PostgreSQL with pgvector)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-32-byte-hex-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# n8n Automation Webhooks
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/daily-productive

# Google Gemini API (Embeddings & RAG Chat)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend Environment (inside frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
